# ================================================================
# QA AI Assistant — Variables de Entorno
# Copiar como .env y completar valores reales
# ================================================================

# ===== Base de Datos (GCP Cloud SQL PostgreSQL) =====
# Formato: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Para GCP Cloud SQL con Cloud SQL Auth Proxy local:
#   DATABASE_URL=postgresql+asyncpg://qauser:password@localhost:5432/qa_assistant
# Para conexión directa con IP pública de GCP (no recomendado sin SSL):
#   DATABASE_URL=postgresql+asyncpg://qauser:password@34.XX.XX.XX:5432/qa_assistant
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/qa_assistant

# ===== Redis (Celery broker y WebSocket pub/sub) =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===== Seguridad =====
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# Clave AES-256 para cifrado de credenciales (RNF-003)
# Generar con: python3 -c "import secrets; print(secrets.token_bytes(32).hex())"
# CRÍTICO: Nunca compartir. Si se pierde, las credenciales cifradas son irrecuperables.
ENCRYPTION_KEY=CHANGE_ME_generate_with_secrets_token_bytes_32_hex

# ===== JWT =====
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# ===== CORS (orígenes permitidos para el frontend) =====
# Formato JSON array (requerido por pydantic-settings):
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== Frontend (destino del redirect tras el callback OAuth) =====
FRONTEND_URL=http://localhost:5173

# ===== Almacenamiento temporal de sesiones =====
SESSIONS_BASE_DIR=/tmp/qa-sessions
SESSION_TTL_HOURS=48

# ===== SSO — OAuth2 =====
# --- Google (https://console.cloud.google.com/apis/credentials) ---
#   Tipo "OAuth client ID" → "Web application"
#   Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Jira / Atlassian (https://developer.atlassian.com/console/myapps/) ---
#   App "OAuth 2.0 (3LO)" · scope: read:me
#   Callback URL: http://localhost:8000/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/auth/jira/callback

# --- Azure DevOps --- (se habilitará más adelante)

# ===== SSL Corporativo =====
# Poner 'true' si hay un proxy SSL corporativo que da errores de certificado
DISABLE_SSL_VERIFY=false

# ===== Entorno =====
ENVIRONMENT=development
